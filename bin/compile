#!/bin/bash
# usage: bin/compile <build-dir> <cache-dir> <env-dir>

set -eo pipefail

BUILD_DIR=${1:-}
CACHE_DIR=${2:-}
ENV_DIR=${3:-}
buildpack="$(cd -P "$(dirname "$0")" && pwd)"

source "${buildpack}/common.sh"

if [ -n "$BUILDPACK_DEBUG" ]; then
  set -x
fi

MATTERMOST_PATH="$BUILD_DIR/mattermost"
TMP_PATH="$BUILD_DIR/tmp"
mkdir -p "${BUILD_DIR}/bin" "${CACHE_DIR}/dist" "${CACHE_DIR}/dist/plugins" "${TMP_PATH}"
export PATH="$BUILD_DIR/bin:$PATH"

ARCH="$(detect_arch)"

# jq is required by config merge and plugins installation
install_jq

if [[ -f "$ENV_DIR/MATTERMOST_VERSION" ]]; then
  MATTERMOST_VERSION=$(cat "$ENV_DIR/MATTERMOST_VERSION")
else
  MATTERMOST_VERSION="12.1.0"
fi

if [[ -f "${ENV_DIR}/MATTERMOST_EDITION" ]]; then
  warn "MATTERMOST_EDITION is ignored: mostlymatter is built from the open source edition"
fi

step "Fetch Mattermost ${MATTERMOST_VERSION} team dist (${ARCH})"
rm -rf "${MATTERMOST_PATH}"
fetch_mattermost_dist "${MATTERMOST_VERSION}" "${TMP_PATH}" | indent
mv "${TMP_PATH}/mattermost" "${MATTERMOST_PATH}"
finished

step "Fetch mostlymatter ${MATTERMOST_VERSION} (${ARCH})"
fetch_mostlymatter "${MATTERMOST_VERSION}" "${MATTERMOST_PATH}/bin/mostlymatter" | indent
# Replace the upstream server binary so that `mattermost` commands run mostlymatter
ln -sf mostlymatter "${MATTERMOST_PATH}/bin/mattermost"
finished

PREPACKAGED_PLUGINS_PATH="$MATTERMOST_PATH/prepackaged_plugins"
mkdir -p "$BUILD_DIR/plugins" "$MATTERMOST_PATH/client/plugins" "$PREPACKAGED_PLUGINS_PATH"

start "Apply buildpack config"
BUILDPACK_CONFIG="${buildpack}/../config.json"
MM_CONFIG_PATH="${MATTERMOST_PATH}/config/config.json"
if [[ -f "$BUILDPACK_CONFIG" ]] && [[ -f "$MM_CONFIG_PATH" ]]; then
  jq -s '.[0] * .[1]' "$MM_CONFIG_PATH" "$BUILDPACK_CONFIG" >"${MM_CONFIG_PATH}.tmp"
  mv "${MM_CONFIG_PATH}.tmp" "$MM_CONFIG_PATH"
  info "Buildpack config applied from config.json"
else
  warn "Skipping config merge (config.json or Mattermost config not found)"
fi
finished

start "Install plugins list from marketplace"
if [[ -f "${ENV_DIR}/MATTERMOST_MARKETPLACE_PLUGINS" ]]; then
  MATTERMOST_MARKETPLACE_PLUGINS=$(cat "$ENV_DIR/MATTERMOST_MARKETPLACE_PLUGINS")
else
  MATTERMOST_MARKETPLACE_PLUGINS=""
fi
if [[ -n $MATTERMOST_MARKETPLACE_PLUGINS ]]; then
  install_marketplace_plugins_list "$PREPACKAGED_PLUGINS_PATH" "${MATTERMOST_VERSION}" "${MATTERMOST_MARKETPLACE_PLUGINS}"
else
  info "No plugins from marketplace to install"
fi
finished

start "Install plugins list from Github"
if [[ -f "${ENV_DIR}/MATTERMOST_GITHUB_PLUGINS" ]]; then
  MATTERMOST_GITHUB_PLUGINS=$(cat "$ENV_DIR/MATTERMOST_GITHUB_PLUGINS")
else
  MATTERMOST_GITHUB_PLUGINS=""
fi
if [[ -n $MATTERMOST_GITHUB_PLUGINS ]]; then
  install_github_plugins_list "$PREPACKAGED_PLUGINS_PATH" "${MATTERMOST_GITHUB_PLUGINS}"
else
  info "No plugins from Github to install"
fi
finished

if [[ -f "${ENV_DIR}/MATTERMOST_PREPACKAGED_PLUGINS" ]]; then
  warn "MATTERMOST_PREPACKAGED_PLUGINS is ignored: prepackaged plugins are installed at boot when enabled in plugin settings"
fi

info "Using mostlymatter version: ${MATTERMOST_VERSION}" | indent

start "Building run"
cp "${buildpack}/run.sh" "${MATTERMOST_PATH}/bin/run"
chmod +x "${MATTERMOST_PATH}/bin/run"
finished

step "Cleaning up tmp files"
rm -rf "${TMP_PATH}"

finished
